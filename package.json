{
  "name": "fontseru",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "FontSeru — a modern, browser-based vector type & font design studio. Original clean editor UI with a professional Bézier engine.",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@types/pako": "^2.0.4",
    "dexie": "^4.0.8",
    "fontverter": "^2.0.0",
    "imagetracerjs": "^1.2.6",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.454.0",
    "opentype.js": "^1.3.4",
    "pako": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg-pathdata": "^7.1.0",
    "uuid": "^9.0.1",
    "woff2-encoder": "^2.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "20",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
